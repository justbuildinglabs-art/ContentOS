{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "brief_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "verdict": { "type": "string", "enum": ["pass", "revise", "reject"] },
    "checks": {
      "type": "object",
      "properties": {
        "hook_first_3s": { "type": "string", "enum": ["pass", "fail", "na"] },
        "hook_matches_brief": { "type": "string", "enum": ["pass", "fail", "na"] },
        "payoff_present": { "type": "string", "enum": ["pass", "fail", "na"] },
        "consistent_with_profile": { "type": "string", "enum": ["pass", "fail", "na"] },
        "no_fabricated_claims": { "type": "string", "enum": ["pass", "fail", "na"] },
        "no_fake_testimonial": { "type": "string", "enum": ["pass", "fail", "na"] },
        "no_restricted_claims": { "type": "string", "enum": ["pass", "fail", "na"] },
        "not_a_clone": { "type": "string", "enum": ["pass", "fail", "na"] },
        "cta_present": { "type": "string", "enum": ["pass", "fail", "na"] },
        "brand_voice": { "type": "string", "enum": ["pass", "fail", "na"] },
        "ai_tells": { "type": "string", "enum": ["pass", "fail", "na"] }
      },
      "required": [
        "hook_first_3s", "hook_matches_brief", "payoff_present", "consistent_with_profile",
        "no_fabricated_claims", "no_fake_testimonial", "no_restricted_claims", "not_a_clone",
        "cta_present", "brand_voice", "ai_tells"
      ]
    },
    "scores": {
      "type": "object",
      "properties": {
        "hook_scroll_stop": { "type": "integer", "minimum": 1, "maximum": 10 },
        "hook_specificity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "hook_emotional_charge": { "type": "integer", "minimum": 1, "maximum": 10 },
        "hook_voice_match": { "type": "integer", "minimum": 1, "maximum": 10 },
        "hook_differentiation": { "type": "integer", "minimum": 1, "maximum": 10 },
        "body_argument_clarity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "body_emotional_arc": { "type": "integer", "minimum": 1, "maximum": 10 },
        "body_proof_density": { "type": "integer", "minimum": 1, "maximum": 10 },
        "body_pacing": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cta_action_clarity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cta_friction": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cta_momentum": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cta_urgency": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "required": [
        "hook_scroll_stop", "hook_specificity", "hook_emotional_charge", "hook_voice_match",
        "hook_differentiation", "body_argument_clarity", "body_emotional_arc", "body_proof_density",
        "body_pacing", "cta_action_clarity", "cta_friction", "cta_momentum", "cta_urgency"
      ]
    },
    "length_check": {
      "type": "object",
      "properties": {
        "word_count": { "type": "integer" },
        "word_budget": { "type": "integer" },
        "within_tolerance": { "type": "boolean" }
      },
      "required": ["word_count", "word_budget", "within_tolerance"]
    },
    "filler_cut_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["line", "reason"]
      }
    },
    "placeholders": { "type": "array", "items": { "type": "string" } },
    "strongest_line": { "type": ["string", "null"] },
    "weakest_lines": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
    "one_watch_test": { "type": "string" },
    "spoken_flow_issues": { "type": "array", "items": { "type": "string" } },
    "cringe_flags": { "type": "array", "items": { "type": "string" } },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_or_score": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "detail": { "type": "string" },
          "fix": { "type": "string" }
        },
        "required": ["check_or_score", "severity", "detail", "fix"]
      }
    },
    "summary": { "type": "string" },
    "confidence": { "type": "integer", "minimum": 1, "maximum": 10 }
  },
  "required": [
    "brief_id", "revision", "verdict", "checks", "scores", "length_check", "filler_cut_list",
    "placeholders", "strongest_line", "weakest_lines", "one_watch_test", "spoken_flow_issues",
    "cringe_flags", "issues", "summary", "confidence"
  ]
}
